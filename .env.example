# --------------------------------------------------------------------------
# 📱 Configuración de Aplicación
# --------------------------------------------------------------------------
APP_NAME="Laravel BoilerPlate"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE='America/Argentina/Tucuman'
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# --------------------------------------------------------------------------
# 🛠️ Configuración de Sistema
# --------------------------------------------------------------------------
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------------------
# 🗄️ Base de Datos
# --------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_boilerplate
DB_USERNAME=root
DB_PASSWORD=

# --------------------------------------------------------------------------
# ⚡ Almacenamiento y Sesiones (Redis / Database)
# --------------------------------------------------------------------------
# !INFO Usar 'redis' en producción para Queue y Cache para máxima velocidad.
# !NOTE Mantener 'database' en SESSION_DRIVER para el control centralizado de dispositivos.
# !STUB Para local si no tienes Redis: CACHE_STORE=file | QUEUE_CONNECTION=database
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database
# Lifetime en minutos (525600 = 1 año). Inactividad permitida antes de expirar.
SESSION_LIFETIME=525600
# Si es true, la sesión muere al cerrar el navegador. Mantener en false para persistencia.
SESSION_EXPIRE_ON_CLOSE=false
# Cifra los datos de la sesión. Útil si la DB es compartida o poco segura.
SESSION_ENCRYPT=false
# Ruta donde la cookie es válida. '/' significa en todo el sitio.
SESSION_PATH=/
# Si es null, la cookie solo sirve para el dominio exacto. 
# Usa '.tudominio.com' para que sirva en todos los subdominios.
SESSION_DOMAIN=null
# En producción, debe ser true para que las cookies viajen solo por HTTPS (OBLIGATORIO).
SESSION_SECURE_COOKIE=false
# Protege contra XSS: Impide que JavaScript acceda a la cookie de sesión.
SESSION_HTTP_ONLY=true
# Controla el envío de cookies en peticiones cruzadas. 'lax' es el estándar recomendado.
SESSION_SAME_SITE=lax

# --------------------------------------------------------------------------
# 🛰️ Broadcast & Filesystem
# --------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --------------------------------------------------------------------------
# 🔴 Redis Cache & Queue Manager
# --------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# ☁️ Amazon Web Services (S3 Storage)
# --------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_S3_URL_BASE=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --------------------------------------------------------------------------
# 💾 Sistema de Backups (Spatie)
# --------------------------------------------------------------------------
BACKUP_ARCHIVE_PASSWORD=
BACKUP_MAIL_TO_ADDRESS="heloo@laravel-boilerplate.com"
BACKUP_MAIL_FROM_ADDRESS="noreply@laravel-boilerplate.com"
BACKUP_MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# 📧 Correo Electrónico (Mailgun / SMTP)
# --------------------------------------------------------------------------
MAIL_MAILER=mailgun
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAIL_SCHEME=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# 🔔 Notificaciones Push (Firebase)
# --------------------------------------------------------------------------
FIREBASE_CREDENTIALS=

# --------------------------------------------------------------------------
# 💬 Mensajería SMS (Twilio)
# --------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# --------------------------------------------------------------------------
# 🔗 Seguridad & CORS
# --------------------------------------------------------------------------
ALLOWED_ORIGINS=
POSTMAN_API_KEYS=
MOBILE_APP_API_KEYS=

# --------------------------------------------------------------------------
# 🪝 Webhooks & Integraciones Externas
# --------------------------------------------------------------------------
MY_PROJECT_WEBHOOK_SECRET_KEY=
MY_PROJECT_WEBHOOK_SECRET_HEADER="Signature"

OTHER_PROJECT_BASE_URL=
OTHER_PROJECT_EMAIL=
OTHER_PROJECT_PASSWORD=
OTHER_PROJECT_PARTNER_KEY=